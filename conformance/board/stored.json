{
  "description": "What the board reads from the settings memory at start: the light record and the board record as one blob under `settings`. The blob is written in one step, so a save of both records is all or nothing. A damaged blob gives the defaults; `token` null means a new token is made (16 characters of a-z and 0-9). The record bytes are laid out by an independent script from the two stored-record tables.",
  "cases": [
    {
      "note": "the blob: the light record of 17 bytes, then the board record of 255",
      "keys": {
        "settings": ""
      },
      "expect": {
        "brightness": 60,
        "effect": "static",
        "check_hours": 12,
        "token": "abcdefghij012345"
      }
    },
    {
      "note": "a light record of brightness 80 and the breathing effect",
      "keys": {
        "settings": ""
      },
      "expect": {
        "brightness": 80,
        "effect": "breathing",
        "check_hours": 6,
        "token": "abcdefghij012345"
      }
    },
    {
      "note": "a blob one byte short is damaged: defaults and a new token",
      "keys": {
        "settings": ""
      },
      "expect": {
        "brightness": 60,
        "effect": "static",
        "check_hours": 6,
        "token": null
      }
    },
    {
      "note": "nothing stored: defaults and a new token",
      "keys": {},
      "expect": {
        "brightness": 60,
        "effect": "static",
        "check_hours": 6,
        "token": null
      }
    }
  ]
}
