{
  "description": "What the board reads from the settings memory at start: the light record and the board record as one blob under `settings`. The blob is written in one step, so a save of both records is all or nothing. A blob of 273 bytes holds a light record of version 2; one of 272 bytes, written by firmware 1.1.0 and earlier, a light record of version 1, read with every value kept and the default `breath_pattern`. Any other blob is damaged and gives the defaults; `token` null means a new token is made (16 characters of a-z and 0-9). The record bytes are laid out by an independent script from the two stored-record tables.",
  "cases": [
    {
      "note": "a version 1 blob (firmware 1.1.0): the light record of 17 bytes, then the board record of 255",
      "keys": {
        "settings": ""
      },
      "expect": {
        "brightness": 60,
        "effect": "static",
        "check_hours": 12,
        "token": "abcdefghij012345",
        "breath_pattern": "4-7-8"
      }
    },
    {
      "note": "a version 1 light record of brightness 80 and the breathing effect keeps every value and gets the default pattern",
      "keys": {
        "settings": ""
      },
      "expect": {
        "brightness": 80,
        "effect": "breathing",
        "check_hours": 6,
        "token": "abcdefghij012345",
        "breath_pattern": "4-7-8"
      }
    },
    {
      "note": "a version 2 blob: the light record of 18 bytes (guided breathing, aurora, box), then the board record of 255",
      "keys": {
        "settings": ""
      },
      "expect": {
        "brightness": 80,
        "effect": "guided_breathing",
        "color_set": "aurora",
        "breath_pattern": "box",
        "check_hours": 12,
        "token": "abcdefghij012345"
      }
    },
    {
      "note": "a version 2 light record in a 272-byte blob is damaged: defaults and a new token",
      "keys": {
        "settings": ""
      },
      "expect": {
        "brightness": 60,
        "effect": "static",
        "breath_pattern": "4-7-8",
        "check_hours": 6,
        "token": null
      }
    },
    {
      "note": "a version 1 light record in a 273-byte blob is damaged: defaults and a new token",
      "keys": {
        "settings": ""
      },
      "expect": {
        "brightness": 60,
        "effect": "static",
        "breath_pattern": "4-7-8",
        "check_hours": 6,
        "token": null
      }
    },
    {
      "note": "a blob one byte short is damaged: defaults and a new token",
      "keys": {
        "settings": ""
      },
      "expect": {
        "brightness": 60,
        "effect": "static",
        "check_hours": 6,
        "token": null
      }
    },
    {
      "note": "nothing stored: defaults and a new token",
      "keys": {},
      "expect": {
        "brightness": 60,
        "effect": "static",
        "check_hours": 6,
        "token": null
      }
    }
  ]
}
