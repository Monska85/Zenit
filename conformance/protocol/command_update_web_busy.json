{
  "description": "A web install that cannot wait for a page still being sent (the board gives up after its wait) is unreachable, a busy board tried again later, not flash_error: the image in the partition is untouched, the offer stays, and the install works once the page is out.",
  "steps": [
    {
      "advance_ms": 1100
    },
    {
      "control": "!www erase"
    },
    {
      "control": "!update web publish 1.1.0 1 1"
    },
    {
      "control": "!www fail busy"
    },
    {
      "control": "!net state=connected ssid=HomeNet rssi=-50 ip=10.0.0.5 synced=1 epoch=1790000000"
    },
    {
      "advance_ms": 1000
    },
    {
      "send": {
        "seq": 1,
        "cmd": "update_install",
        "target": "web"
      },
      "expect": {
        "seq": 1,
        "ok": true,
        "update": {
          "mode": "automatic",
          "state": "downloading",
          "available": null,
          "last_check": {
            "$any": "integer"
          },
          "last_result": "unreachable",
          "progress": 0,
          "trial": false,
          "skipped": null,
          "rolled_back": null,
          "target": "web",
          "web": {
            "state": "missing",
            "version": null,
            "available": "1.1.0",
            "last_result": "unreachable",
            "retry_in": {
              "$any": "integer"
            }
          }
        }
      }
    },
    {
      "control": "!www fail none"
    },
    {
      "advance_ms": 1000
    },
    {
      "send": {
        "seq": 2,
        "cmd": "update_check"
      },
      "expect": {
        "seq": 2,
        "ok": true,
        "update": {
          "mode": "automatic",
          "state": "checking",
          "available": null,
          "last_check": {
            "$any": "integer"
          },
          "last_result": "unreachable",
          "progress": null,
          "trial": false,
          "skipped": null,
          "rolled_back": null,
          "target": "firmware",
          "web": {
            "state": "ok",
            "version": "1.1.0",
            "available": null,
            "last_result": "installed",
            "retry_in": null
          }
        }
      }
    }
  ]
}
