{
  "description": "light needs on, a boolean.",
  "steps": [
    {
      "send": {
        "seq": 1,
        "cmd": "light"
      },
      "expect": {
        "seq": 1,
        "ok": false,
        "error": "bad_request"
      }
    },
    {
      "send": {
        "seq": 2,
        "cmd": "light",
        "on": null
      },
      "expect": {
        "seq": 2,
        "ok": false,
        "error": "bad_request"
      }
    },
    {
      "send": {
        "seq": 3,
        "cmd": "light",
        "on": 1
      },
      "expect": {
        "seq": 3,
        "ok": false,
        "error": "bad_request"
      }
    },
    {
      "send": {
        "seq": 4,
        "cmd": "light",
        "on": "true"
      },
      "expect": {
        "seq": 4,
        "ok": false,
        "error": "bad_request"
      }
    },
    {
      "send": {
        "seq": 5,
        "cmd": "light",
        "on": [
          true
        ]
      },
      "expect": {
        "seq": 5,
        "ok": false,
        "error": "bad_request"
      }
    },
    {
      "send": {
        "seq": 6,
        "cmd": "light",
        "off": true
      },
      "expect": {
        "seq": 6,
        "ok": false,
        "error": "bad_request"
      }
    }
  ]
}
