{
  "description": "status reports the color lit once a color change has faded in.",
  "steps": [
    {
      "advance_ms": 1000
    },
    {
      "send": {
        "seq": 1,
        "cmd": "settings_set",
        "color": "red"
      },
      "expect": {
        "seq": 1,
        "ok": true,
        "settings": {
          "brightness": 60,
          "effect": "static",
          "color": "red",
          "colors": [
            "red",
            "green",
            "blue",
            "white"
          ],
          "color_set": "christmas",
          "hold_seconds": 30,
          "period_seconds": 8,
          "floor": 20,
          "twinkle_strength": 20,
          "timer_minutes": 0,
          "wifi_power": "auto",
          "update_mode": "automatic",
          "update_firmware": true,
          "check_hours": 6,
          "install_start": 0,
          "install_end": 0,
          "timezone": "UTC0",
          "time_sync_hours": 6,
          "ntp_server": "pool.ntp.org",
          "network_login": false,
          "token": {
            "$pattern": "^[a-z0-9]{16}$"
          }
        }
      }
    },
