{
  "description": "A new board lists the two ready-made favorites; saving, renaming, replacing and deleting reply with the whole list. A saved favorite holds the effect, the brightness and what that effect reads.",
  "steps": [
    {
      "send": {
        "seq": 1,
        "cmd": "favorites"
      },
      "expect": {
        "seq": 1,
        "ok": true,
        "favorites": [
          {
            "id": 1,
            "name": "Starry night",
            "effect": "shooting_star",
            "brightness": 60,
            "color": "white"
          },
          {
            "id": 2,
            "name": "Christmas",
            "effect": "christmas",
            "brightness": 60,
            "color_set": "christmas",
            "hold_seconds": 30
          }
        ],
        "start": null
      }
    },
    {
      "send": {
        "seq": 2,
        "cmd": "settings_set",
        "brightness": 40,
        "effect": "breathing",
        "color": "red",
        "period_seconds": 12
      },
      "expect": {
        "seq": 2,
        "ok": true,
        "settings": {
          "brightness": 40,
          "effect": "breathing",
          "color": "red",
          "colors": [
            "red",
            "green",
            "blue",
            "white"
          ],
          "color_set": "christmas",
          "hold_seconds": 30,
          "period_seconds": 12,
          "breath_pattern": "4-7-8",
          "floor": 20,
          "twinkle_strength": 20,
          "timer_minutes": 0,
          "wifi_power": "auto",
          "update_mode": "automatic",
          "update_firmware": true,
          "update_web": true,
          "check_hours": 6,
          "install_start": 0,
          "install_end": 0,
          "timezone": "UTC0",
          "time_sync_hours": 6,
          "ntp_server": "pool.ntp.org",
          "network_login": false,
          "token": {
            "$pattern": "^[a-z0-9]{16}$"
          }
        }
      }
    },
    {
      "note": "The name arrives with an escape and is stored as UTF-8: Città.",
      "send": "@ZN 456f6833 {\"seq\":3,\"cmd\":\"favorite_save\",\"name\":\"Citt\\u00e0\"}",
      "expect": {
        "seq": 3,
        "ok": true,
        "favorites": [
          {
            "id": 1,
            "name": "Starry night",
            "effect": "shooting_star",
            "brightness": 60,
            "color": "white"
          },
          {
            "id": 2,
            "name": "Christmas",
            "effect": "christmas",
            "brightness": 60,
            "color_set": "christmas",
            "hold_seconds": 30
          },
          {
            "id": 3,
            "name": "Città",
            "effect": "breathing",
            "brightness": 40,
            "color": "red",
            "period_seconds": 12,
            "floor": 20
          }
        ],
        "start": null
      }
    },
    {
      "send": {
        "seq": 4,
        "cmd": "favorite_rename",
        "id": 2,
        "name": "Winter"
      },
      "expect": {
        "seq": 4,
        "ok": true,
        "favorites": [
          {
            "id": 1,
            "name": "Starry night",
            "effect": "shooting_star",
            "brightness": 60,
            "color": "white"
          },
          {
            "id": 2,
            "name": "Winter",
            "effect": "christmas",
            "brightness": 60,
            "color_set": "christmas",
            "hold_seconds": 30
          },
          {
            "id": 3,
            "name": "Città",
            "effect": "breathing",
            "brightness": 40,
            "color": "red",
            "period_seconds": 12,
            "floor": 20
          }
        ],
        "start": null
      }
    },
    {
      "send": {
        "seq": 5,
        "cmd": "settings_set",
        "effect": "twinkle",
        "twinkle_strength": 35
      },
      "expect": {
        "seq": 5,
        "ok": true,
        "settings": {
          "brightness": 40,
          "effect": "twinkle",
          "color": "red",
          "colors": [
            "red",
            "green",
            "blue",
            "white"
          ],
          "color_set": "christmas",
          "hold_seconds": 30,
          "period_seconds": 12,
          "breath_pattern": "4-7-8",
          "floor": 20,
          "twinkle_strength": 35,
          "timer_minutes": 0,
          "wifi_power": "auto",
          "update_mode": "automatic",
          "update_firmware": true,
          "update_web": true,
          "check_hours": 6,
          "install_start": 0,
          "install_end": 0,
          "timezone": "UTC0",
          "time_sync_hours": 6,
          "ntp_server": "pool.ntp.org",
          "network_login": false,
          "token": {
            "$pattern": "^[a-z0-9]{16}$"
          }
        }
      }
    },
    {
      "send": {
        "seq": 6,
        "cmd": "favorite_save",
        "id": 3
      },
      "expect": {
        "seq": 6,
        "ok": true,
        "favorites": [
          {
            "id": 1,
            "name": "Starry night",
            "effect": "shooting_star",
            "brightness": 60,
            "color": "white"
          },
          {
            "id": 2,
            "name": "Winter",
            "effect": "christmas",
            "brightness": 60,
            "color_set": "christmas",
            "hold_seconds": 30
          },
          {
            "id": 3,
            "name": "Città",
            "effect": "twinkle",
            "brightness": 40,
            "color": "red",
            "twinkle_strength": 35
          }
        ],
        "start": null
      }
    },
    {
      "send": {
        "seq": 7,
        "cmd": "favorite_delete",
        "id": 2
      },
      "expect": {
        "seq": 7,
        "ok": true,
        "favorites": [
          {
            "id": 1,
            "name": "Starry night",
            "effect": "shooting_star",
            "brightness": 60,
            "color": "white"
          },
          {
            "id": 3,
            "name": "Città",
            "effect": "twinkle",
            "brightness": 40,
            "color": "red",
            "twinkle_strength": 35
          }
        ],
        "start": null
      }
    },
    {
      "note": "Ids are not given again at once: the next one is 4.",
      "send": {
        "seq": 8,
        "cmd": "favorite_save",
        "name": "Christmas"
      },
      "expect": {
        "seq": 8,
        "ok": true,
        "favorites": [
          {
            "id": 1,
            "name": "Starry night",
            "effect": "shooting_star",
            "brightness": 60,
            "color": "white"
          },
          {
            "id": 3,
            "name": "Città",
            "effect": "twinkle",
            "brightness": 40,
            "color": "red",
            "twinkle_strength": 35
          },
          {
            "id": 4,
            "name": "Christmas",
            "effect": "twinkle",
            "brightness": 40,
            "color": "red",
            "twinkle_strength": 35
          }
        ],
        "start": null
      }
    }
  ]
}
