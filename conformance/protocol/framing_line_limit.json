{
  "description": "A line of 1,024 bytes is read; one byte more is bad_frame when it has the marker, and ignored when it has not.",
  "steps": [
    {
      "send": "@ZN 914e0e2e {\"seq\":7,\"cmd\":\"info\",\"x\":\"\"}",
      "expect": {
        "seq": 7,
        "ok": false,
        "error": "bad_request"
      },
      "note": "exactly 1,024 bytes: read, and refused for its unknown field"
    },
    {
      "send": "@ZN 914e0e2e {\"seq\":7,\"cmd\":\"info\",\"x\":\"\"}\r",
      "expect": {
        "seq": 7,
        "ok": false,
        "error": "bad_request"
      },
      "note": "the carriage return is not counted"
    },
    {
      "send_padded": {
        "prefix": "@ZN 00000000 ",
        "fill": "x",
        "count": 1012
      },
      "expect": {
        "ok": false,
        "error": "bad_frame"
      },
      "note": "1,025 bytes"
    },
    {
      "send_padded": {
        "prefix": "@ZN 00000000 ",
        "fill": "x",
        "count": 4000
      },
      "expect": {
        "ok": false,
        "error": "bad_frame"
      },
      "note": "far over"
    },
    {
      "send_padded": {
        "prefix": "zenit: ",
        "fill": "x",
        "count": 1100
      },
      "expect": null,
      "note": "no marker: ignored"
    },
    {
      "send": "@ZN 3c250228 {\"seq\":1,\"cmd\":\"info\"}",
      "expect": {
        "seq": 1,
        "ok": true,
        "protocol": 1,
        "firmware": {
          "$any": "string"
        },
        "board": "simulator",
        "boot_id": 4242,
        "colors": [
          "white",
          "red",
          "green",
          "blue"
        ],
        "effects": [
