            "blue",
            "white"
          ],
          "color_set": "christmas",
          "hold_seconds": 30,
          "period_seconds": 8,
          "breath_pattern": "4-7-8",
          "floor": 20,
          "twinkle_strength": 20,
          "timer_minutes": 0,
          "wifi_power": "auto",
          "update_mode": "automatic",
          "update_firmware": true,
          "update_web": true,
          "check_hours": 6,
          "install_start": 0,
          "install_end": 0,
          "timezone": "UTC0",
          "time_sync_hours": 6,
          "ntp_server": "pool.ntp.org",
          "network_login": false,
          "token": {
            "$pattern": "^[a-z0-9]{16}$"
          }
        }
      }
    },
    {
      "send": {
        "seq": 8,
        "cmd": "favorite_start",
        "id": null
      },
      "expect": {
        "seq": 8,
        "ok": true,
        "favorites": [
          {
            "id": 1,
            "name": "Starry night",
            "effect": "shooting_star",
            "brightness": 60,
            "color": "white"
          },
          {
            "id": 2,
            "name": "Christmas",
            "effect": "christmas",
            "brightness": 60,
            "color_set": "christmas",
            "hold_seconds": 30
          }
        ],
        "start": null
      }
    },
    {
      "send": {
        "seq": 9,
        "cmd": "favorite_start",
        "id": 2
      },
      "expect": {
        "seq": 9,
        "ok": true,
        "favorites": [
          {
            "id": 1,
            "name": "Starry night",
            "effect": "shooting_star",
            "brightness": 60,
            "color": "white"
          },
          {
            "id": 2,
            "name": "Christmas",
            "effect": "christmas",
            "brightness": 60,
            "color_set": "christmas",
            "hold_seconds": 30
          }
        ],
        "start": 2
      }
    },
    {
      "send": {
        "seq": 10,
