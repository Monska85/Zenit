{
  "description": "A newline inside the JSON is bad_frame over a WebSocket, where a message can hold one; on USB it ends the line.",
  "steps": [
    {
      "send": "@ZN bd975bc7 {\"seq\":1,\n\"cmd\":\"info\"}",
      "expect": {
        "ok": false,
        "error": "bad_frame"
      },
      "transport": "wifi",
      "note": "a message with a newline and a matching checksum"
    },
    {
      "send": "@ZN bd975bc7 {\"seq\":1,\n\"cmd\":\"info\"}",
      "expect": {
        "ok": false,
        "error": "bad_frame"
      },
      "transport": "usb",
      "note": "on USB the line ends at the newline: the first part has a wrong checksum and the second part is not a protocol line"
    },
    {
      "send": "@ZN 3c250228 {\"seq\":1,\"cmd\":\"info\"}",
      "expect": {
        "seq": 1,
        "ok": true,
        "protocol": 1,
