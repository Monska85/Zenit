{
  "description": "With network_login on a WiFi client can send only info, auth_challenge and auth until it logs in. The HMAC-SHA256 of the 32 hexadecimal characters of the nonce under the 16 token characters (computed with an independent implementation) logs in; a nonce serves one attempt; three failures ask to close the connection; USB needs no login.",
  "steps": [
    {
      "advance_ms": 1100
    },
    {
      "control": "!token abcdefghij012345"
    },
    {
      "send": {
        "seq": 1,
        "cmd": "settings_set",
        "network_login": true
      },
      "expect": {
        "seq": 1,
        "ok": true,
        "settings": {
          "brightness": 60,
          "effect": "static",
          "color": "white",
          "colors": [
            "red",
            "green",
            "blue",
            "white"
          ],
          "color_set": "christmas",
          "hold_seconds": 30,
          "period_seconds": 8,
          "breath_pattern": "4-7-8",
          "floor": 20,
          "twinkle_strength": 20,
          "timer_minutes": 0,
          "wifi_power": "auto",
          "update_mode": "automatic",
          "update_firmware": true,
          "update_web": true,
          "check_hours": 6,
          "install_start": 0,
          "install_end": 0,
          "timezone": "UTC0",
          "time_sync_hours": 6,
          "ntp_server": "pool.ntp.org",
          "network_login": true,
          "token": {
            "$pattern": "^[a-z0-9]{16}$"
          }
        }
      },
      "transport": "usb",
      "close": true
    },
    {
      "event": "wifi_open"
    },
    {
      "send": {
        "seq": 2,
        "cmd": "status"
      },
      "expect": {
        "seq": 2,
        "ok": false,
        "error": "unauthorized"
      },
      "transport": "wifi"
    },
    {
      "send": {
        "seq": 3,
        "cmd": "settings_get"
      },
      "expect": {
        "seq": 3,
        "ok": false,
        "error": "unauthorized"
      },
      "transport": "wifi"
    },
    {
      "send": {
        "seq": 4,
        "cmd": "light",
        "on": false
      },
      "expect": {
        "seq": 4,
        "ok": false,
        "error": "unauthorized"
      },
      "transport": "wifi"
    },
    {
      "send": {
        "seq": 5,
        "cmd": "bogus"
      },
