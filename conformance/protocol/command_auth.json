      "send": {
        "seq": 6,
        "cmd": "info"
      },
      "expect": {
        "seq": 6,
        "ok": true,
        "protocol": 1,
        "firmware": {
          "$any": "string"
        },
        "board": "simulator",
        "boot_id": 4242,
        "colors": [
