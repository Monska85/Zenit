{
  "description": "The virtual clock keeps every millisecond: steps of 5 ms that end on the 10 ms grid tick it. A client that has not logged in, opened at 0, is asked to be closed at 10,000 ms, reached as 9,995 ms and then 5 ms.",
  "steps": [
    {
      "send": {
        "seq": 1,
        "cmd": "settings_set",
        "network_login": true
      },
      "expect": {
        "seq": 1,
        "ok": true,
        "settings": {
          "brightness": 60,
          "effect": "static",
          "color": "white",
          "colors": [
            "red",
            "green",
            "blue",
            "white"
          ],
          "color_set": "christmas",
          "hold_seconds": 30,
          "period_seconds": 8,
          "breath_pattern": "4-7-8",
          "floor": 20,
          "twinkle_strength": 20,
          "timer_minutes": 0,
          "wifi_power": "auto",
          "update_mode": "automatic",
          "update_firmware": true,
          "update_web": true,
          "check_hours": 6,
          "install_start": 0,
          "install_end": 0,
          "timezone": "UTC0",
          "time_sync_hours": 6,
          "ntp_server": "pool.ntp.org",
          "network_login": true,
          "token": {
            "$pattern": "^[a-z0-9]{16}$"
          }
        }
      },
      "close": true
    },
    {
      "event": "wifi_open"
    },
    {
      "advance_ms": 9995
    },
    {
      "close_requested": false
    },
    {
      "advance_ms": 5
    },
    {
      "close_requested": true
    }
  ]
}
