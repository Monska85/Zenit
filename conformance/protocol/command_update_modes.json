{
  "description": "With update_mode off, or update_firmware and update_web both false, update_check is updates_off; update_install is updates_off for a target whose updates are off; the status shows the mode off. With firmware updates off and web updates on, a check reads the web manifest alone.",
  "steps": [
    {
      "advance_ms": 1100
    },
    {
      "send": {
        "seq": 1,
        "cmd": "settings_set",
        "update_mode": "off"
      },
      "expect": {
        "seq": 1,
        "ok": true,
        "settings": {
          "brightness": 60,
          "effect": "static",
          "color": "white",
          "colors": [
            "red",
            "green",
            "blue",
            "white"
          ],
          "color_set": "christmas",
          "hold_seconds": 30,
          "period_seconds": 8,
          "breath_pattern": "4-7-8",
          "floor": 20,
          "twinkle_strength": 20,
          "timer_minutes": 0,
          "wifi_power": "auto",
          "update_mode": "off",
          "update_firmware": true,
          "update_web": true,
          "check_hours": 6,
          "install_start": 0,
          "install_end": 0,
          "timezone": "UTC0",
          "time_sync_hours": 6,
          "ntp_server": "pool.ntp.org",
          "network_login": false,
          "token": {
            "$pattern": "^[a-z0-9]{16}$"
          }
        }
      }
    },
