{
  "description": "A change of the stored network during a download stops it at once (unreachable), so the radio can leave the old network: wifi_forget while the firmware downloads. The running firmware stays, the version stays offered.",
  "steps": [
    {
      "advance_ms": 1100
    },
    {
      "control": "!store-wifi ssid=HomeNet password=correct-horse"
    },
    {
      "control": "!net state=connected ssid=HomeNet rssi=-50 ip=10.0.0.5 synced=1 epoch=1790000000"
    },
    {
      "send": {
        "seq": 900,
        "cmd": "settings_set",
        "update_mode": "notify"
      },
      "expect": {
        "seq": 900,
        "ok": true,
        "settings": {
          "brightness": 60,
          "effect": "static",
          "color": "white",
          "colors": [
            "red",
            "green",
            "blue",
            "white"
          ],
          "color_set": "christmas",
          "hold_seconds": 30,
          "period_seconds": 8,
          "floor": 20,
          "twinkle_strength": 20,
          "timer_minutes": 0,
          "wifi_power": "auto",
          "update_mode": "notify",
          "update_firmware": true,
          "update_web": true,
          "check_hours": 6,
          "install_start": 0,
          "install_end": 0,
          "timezone": "UTC0",
          "time_sync_hours": 6,
          "ntp_server": "pool.ntp.org",
          "network_login": false,
          "token": {
            "$pattern": "^[a-z0-9]{16}$"
          }
        }
      }
    },
    {
      "control": "!update manifest {\"schema\":1,\"board\":\"esp32c3\",\"version\":\"0.2.0\",\"file\":\"zenit-esp32c3-firmware.bin\",\"size\":65536,\"sha256\":\"de2f256064a0af797747c2b97505dc0b9f3df0de4f489eac731c23ae9ca9cc31\"}"
    },
    {
      "control": "!update firmware 65536 0"
    },
    {
      "control": "!update download ok"
    },
    {
      "send": {
        "seq": 1,
        "cmd": "update_check"
      },
      "expect": {
        "seq": 1,
        "ok": true,
        "update": {
          "mode": "notify",
          "state": "checking",
          "available": null,
          "last_check": null,
          "last_result": "never",
          "progress": null,
          "trial": false,
          "skipped": null,
          "rolled_back": null,
          "target": "firmware",
          "web": {
            "state": "ok",
            "version": "1.0.0",
            "available": null,
            "last_result": {
              "$any": "string"
            },
            "retry_in": null
          }
        }
      }
    },
    {
      "advance_ms": 10
    },
    {
      "send": {
        "seq": 2,
        "cmd": "update_install",
        "target": "firmware"
      },
      "expect": {
        "seq": 2,
        "ok": true,
        "update": {
          "mode": "notify",
          "state": "downloading",
          "available": "0.2.0",
          "last_check": 1790000000,
          "last_result": "available",
          "progress": 0,
          "trial": false,
          "skipped": null,
          "rolled_back": null,
          "target": "firmware",
          "web": {
            "state": "ok",
            "version": "1.0.0",
            "available": null,
            "last_result": {
              "$any": "string"
            },
            "retry_in": null
          }
        }
      }
    },
    {
      "send": {
        "seq": 3,
        "cmd": "wifi_forget"
      },
      "expect": {
        "seq": 3,
        "ok": true
      }
    },
    {
      "advance_ms": 10
    },
    {
      "send": {
        "seq": 4,
        "cmd": "status"
      },
      "expect": {
        "seq": 4,
        "ok": true,
        "light": {
          "on": true,
          "effect": "static",
          "color": "white",
          "lightness": 60.0,
          "power_scale": 100,
          "timer": null
        },
        "wifi": {
          "state": "not_configured",
          "ssid": null,
          "rssi": null,
          "ip": null,
          "hostname": "zenit-0000"
        },
        "time": {
          "synced": true,
          "epoch": 1790000000,
          "local_minute": 853
        },
        "update": {
          "mode": "notify",
          "state": "idle",
          "available": "0.2.0",
          "last_check": 1790000000,
          "last_result": "unreachable",
          "progress": null,
          "trial": false,
          "skipped": null,
          "rolled_back": null,
          "target": null,
          "web": {
            "state": "ok",
            "version": "1.0.0",
            "available": null,
            "last_result": {
              "$any": "string"
            },
            "retry_in": null
          }
        }
      }
    }
  ]
}
