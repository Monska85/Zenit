{
  "description": "wifi_forget erases the stored network over USB only, changes nothing when the settings memory fails, and takes no field.",
  "steps": [
    {
      "advance_ms": 1100
    },
    {
      "control": "!store-wifi ssid=HomeNet password=correct-horse"
    },
    {
      "send": {
        "seq": 1,
        "cmd": "status"
