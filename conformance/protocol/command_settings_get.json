{
  "description": "settings_get holds every light setting, with the defaults of the specification.",
  "steps": [
    {
      "send": {
        "seq": 1,
        "cmd": "settings_get"
      },
      "expect": {
        "seq": 1,
        "ok": true,
        "settings": {
          "brightness": 60,
          "effect": "static",
          "color": "white",
          "colors": [
            "red",
            "green",
            "blue",
            "white"
          ],
          "color_set": "christmas",
          "hold_seconds": 30,
          "period_seconds": 8,
          "floor": 20,
          "twinkle_strength": 20,
          "timer_minutes": 0
        }
      }
    },
    {
      "send": {
        "seq": 2,
        "cmd": "settings_get"
      },
      "expect": {
        "seq": 2,
        "ok": true,
        "settings": {
          "brightness": 60,
          "effect": "static",
          "color": "white",
          "colors": [
            "red",
            "green",
            "blue",
            "white"
          ],
          "color_set": "christmas",
          "hold_seconds": 30,
          "period_seconds": 8,
          "floor": 20,
          "twinkle_strength": 20,
          "timer_minutes": 0
        }
      },
      "transport": "wifi"
    }
  ]
}
