{
  "description": "Every settings_set with a bad value is bad_request and changes nothing, even its good fields.",
  "steps": [
    {
      "send": {
        "seq": 1,
        "cmd": "settings_set"
      },
      "expect": {
        "seq": 1,
        "ok": false,
        "error": "bad_request"
      },
      "note": "no setting at all"
    },
    {
      "send": {
        "seq": 2,
        "cmd": "settings_set",
        "brightness": 0
      },
      "expect": {
        "seq": 2,
        "ok": false,
        "error": "bad_request"
      },
      "note": "brightness 0"
    },
    {
      "send": {
        "seq": 3,
        "cmd": "settings_set",
        "brightness": 101
      },
      "expect": {
        "seq": 3,
        "ok": false,
        "error": "bad_request"
      },
      "note": "brightness 101"
    },
    {
      "send": {
        "seq": 4,
        "cmd": "settings_set",
        "brightness": -1
      },
      "expect": {
        "seq": 4,
        "ok": false,
        "error": "bad_request"
      },
      "note": "brightness negative"
    },
    {
      "send": {
        "seq": 5,
        "cmd": "settings_set",
        "brightness": 60.5
      },
      "expect": {
        "seq": 5,
        "ok": false,
        "error": "bad_request"
      },
      "note": "brightness a float"
    },
    {
