      "expect": {
        "seq": 37,
        "ok": false,
        "error": "bad_request"
      },
      "note": "a good field next to a bad one"
    },
    {
      "send": {
        "seq": 38,
        "cmd": "settings_set",
        "brightness": 50,
        "volume": 3
      },
      "expect": {
        "seq": 38,
        "ok": false,
        "error": "bad_request"
      },
      "note": "a good field next to an unknown one"
    },
    {
      "send": {
        "seq": 100,
        "cmd": "settings_get"
      },
      "expect": {
        "seq": 100,
        "ok": true,
        "settings": {
          "brightness": 60,
          "effect": "static",
          "color": "white",
          "colors": [
            "red",
            "green",
            "blue",
            "white"
          ],
          "color_set": "christmas",
          "hold_seconds": 30,
          "period_seconds": 8,
          "floor": 20,
          "twinkle_strength": 20,
          "timer_minutes": 0,
          "wifi_power": "auto",
          "update_mode": "automatic",
          "update_firmware": true,
          "update_web": true,
          "check_hours": 6,
          "install_start": 0,
          "install_end": 0,
          "timezone": "UTC0",
          "time_sync_hours": 6,
          "ntp_server": "pool.ntp.org",
          "network_login": false,
          "token": {
            "$pattern": "^[a-z0-9]{16}$"
          }
        }
      },
      "note": "nothing changed"
