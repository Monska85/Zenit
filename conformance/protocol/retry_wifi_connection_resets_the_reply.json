{
  "description": "The WiFi transport forgets its remembered reply when a connection opens or closes.",
  "steps": [
    {
      "send": {
        "seq": 4,
        "cmd": "settings_set",
        "brightness": 40
      },
      "expect": {
        "seq": 4,
        "ok": true,
        "settings": {
          "brightness": 40,
          "effect": "static",
          "color": "white",
          "colors": [
            "red",
            "green",
            "blue",
            "white"
          ],
          "color_set": "christmas",
          "hold_seconds": 30,
          "period_seconds": 8,
          "floor": 20,
          "twinkle_strength": 20,
          "timer_minutes": 0
        }
      },
      "transport": "wifi"
    },
    {
      "send": {
        "seq": 8,
        "cmd": "settings_set",
        "brightness": 70
      },
      "expect": {
