{
  "description": "settings_reset puts the board settings back to their defaults, forgets the WiFi network and makes a new token (the chosen random bytes give abcdefghijklmnop), and asks to close the WiFi client.",
  "steps": [
    {
      "advance_ms": 1100
    },
    {
      "send": {
        "seq": 1,
        "cmd": "settings_set",
        "update_mode": "off",
        "timezone": "EST5",
        "network_login": true
      },
      "expect": {
        "seq": 1,
        "ok": true,
        "settings": {
          "brightness": 60,
          "effect": "static",
          "color": "white",
          "colors": [
            "red",
            "green",
            "blue",
            "white"
          ],
          "color_set": "christmas",
          "hold_seconds": 30,
          "period_seconds": 8,
          "breath_pattern": "4-7-8",
          "floor": 20,
          "twinkle_strength": 20,
          "timer_minutes": 0,
          "wifi_power": "auto",
          "update_mode": "off",
          "update_firmware": true,
          "update_web": true,
          "check_hours": 6,
          "install_start": 0,
          "install_end": 0,
          "timezone": "EST5",
          "time_sync_hours": 6,
          "ntp_server": "pool.ntp.org",
          "network_login": true,
          "token": {
            "$pattern": "^[a-z0-9]{16}$"
          }
        }
      },
      "close": true
    },
    {
      "control": "!store-wifi ssid=HomeNet password=correct-horse"
    },
    {
      "control": "!token abcdefghij012345"
    },
    {
      "send": {
        "seq": 2,
        "cmd": "status"
      },
      "expect": {
        "seq": 2,
        "ok": true,
        "light": {
          "on": true,
          "effect": "static",
          "color": "white",
          "lightness": 60.0,
          "power_scale": 100,
          "timer": null
        },
        "wifi": {
          "state": "connecting",
          "ssid": "HomeNet",
          "rssi": null,
          "ip": null,
          "hostname": "zenit-0000"
        },
        "time": {
          "synced": false,
          "epoch": null,
          "local_minute": null
        },
        "update": {
          "mode": "off",
          "state": "idle",
          "available": null,
          "last_check": null,
          "last_result": "never",
          "progress": null,
          "trial": false,
          "skipped": null,
          "rolled_back": null,
          "target": null,
          "web": {
            "state": "ok",
            "version": "1.0.0",
            "available": null,
            "last_result": {
              "$any": "string"
            },
            "retry_in": null
          }
        }
      }
    },
    {
      "control": "!random 000102030405060708090a0b0c0d0e0f"
    },
    {
      "send": {
        "seq": 3,
        "cmd": "settings_reset"
      },
      "expect": {
        "seq": 3,
        "ok": true,
        "settings": {
          "brightness": 60,
          "effect": "static",
          "color": "white",
          "colors": [
            "red",
            "green",
            "blue",
            "white"
          ],
          "color_set": "christmas",
          "hold_seconds": 30,
          "period_seconds": 8,
          "breath_pattern": "4-7-8",
          "floor": 20,
          "twinkle_strength": 20,
          "timer_minutes": 0,
          "wifi_power": "auto",
          "update_mode": "automatic",
          "update_firmware": true,
          "update_web": true,
          "check_hours": 6,
          "install_start": 0,
          "install_end": 0,
          "timezone": "UTC0",
          "time_sync_hours": 6,
          "ntp_server": "pool.ntp.org",
          "network_login": false,
          "token": "abcdefghijklmnop"
        }
      },
      "close": true
    },
    {
      "send": {
        "seq": 4,
        "cmd": "status"
      },
      "expect": {
        "seq": 4,
        "ok": true,
        "light": {
          "on": true,
          "effect": "static",
          "color": "white",
          "lightness": 60.0,
          "power_scale": 100,
          "timer": null
        },
        "wifi": {
          "state": "not_configured",
          "ssid": null,
          "rssi": null,
          "ip": null,
          "hostname": "zenit-0000"
        },
        "time": {
          "synced": false,
          "epoch": null,
          "local_minute": null
        },
        "update": {
          "mode": "automatic",
          "state": "idle",
          "available": null,
          "last_check": null,
          "last_result": "never",
          "progress": null,
          "trial": false,
          "skipped": null,
          "rolled_back": null,
          "target": null,
          "web": {
            "state": "ok",
            "version": "1.0.0",
            "available": null,
            "last_result": {
              "$any": "string"
            },
            "retry_in": null
          }
        }
      }
    }
  ]
}
