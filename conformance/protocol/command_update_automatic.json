{
  "description": "In automatic mode with the window the whole day the board installs the version a check found, by itself.",
  "steps": [
    {
      "advance_ms": 1100
    },
    {
      "control": "!net state=connected ssid=HomeNet rssi=-50 ip=10.0.0.5 synced=1 epoch=1790000000"
    },
    {
      "control": "!update manifest {\"schema\":1,\"board\":\"esp32c3\",\"version\":\"0.2.0\",\"file\":\"zenit-esp32c3-firmware.bin\",\"size\":65536,\"sha256\":\"de2f256064a0af797747c2b97505dc0b9f3df0de4f489eac731c23ae9ca9cc31\"}"
    },
    {
      "control": "!update firmware 65536 0"
    },
    {
      "control": "!update download ok"
    },
    {
      "send": {
        "seq": 1,
        "cmd": "update_check"
      },
      "expect": {
        "seq": 1,
        "ok": true,
        "update": {
          "mode": "automatic",
          "state": "checking",
          "available": null,
          "last_check": null,
          "last_result": "never",
          "progress": null,
          "trial": false,
          "skipped": null,
          "rolled_back": null
        }
      }
    },
    {
      "advance_ms": 300
    },
    {
      "send": {
        "seq": 2,
        "cmd": "status"
      },
      "expect": {
        "seq": 2,
        "ok": true,
        "light": {
          "on": true,
          "effect": "static",
          "color": "white",
          "lightness": 60.0,
          "power_scale": 100,
          "timer": null
        },
        "wifi": {
          "state": "connected",
          "ssid": "HomeNet",
          "rssi": -50,
          "ip": "10.0.0.5",
          "hostname": "zenit-0000"
        },
        "time": {
          "synced": true,
          "epoch": 1790000000,
          "local_minute": 853
        },
        "update": {
          "mode": "automatic",
          "state": "restarting",
          "available": "0.2.0",
          "last_check": 1790000000,
          "last_result": "installed",
          "progress": null,
          "trial": false,
          "skipped": null,
          "rolled_back": null
        }
      }
    }
  ]
}
