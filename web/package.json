{
  "name": "zenit-web",
  "version": "1.2.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "description": "Zenit web app: control a Zenit star projector from the browser",
  "engines": {
    "node": "^26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "size": "node scripts/check-bundle-size.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test && playwright test --config playwright.layout.config.ts",
    "screenshots": "playwright test --config playwright.screenshots.config.ts",
    "screenshots:update": "playwright test --config playwright.screenshots.config.ts --update-snapshots"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "clsx": "2.1.1",
    "esp-web-tools": "10.5.2",
    "i18next": "27.2.5",
    "lucide-react": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "rollup-plugin-license": "3.7.2",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
